rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - man_number: string (required)
    //   - shopId: string (required)
    //   - amuId: string (required)
    //   - role: string (required, 'leadership' | 'ncoic' | 'technician')
    //   - email: string (required)
    //   - status: string (required, 'active' | 'pending' | 'rejected')
    //   - isDemo: bool (optional)
    //
    // Collection: logs
    // Document ID: {logId}
    // Fields:
    //   - tail_number: string (required)
    //   - discrepancy: string (required)
    //   - repair: string (required)
    //   - shopId: string (required)
    //   - amuId: string (required)
    //   - technician_name: string (required)
    //   - man_number: string (required)
    //   - timestamp: timestamp (required)
    //   - jcn: string (optional)
    //   - personnel: list (optional)
    //   - isRedBall: bool (optional)
    //   - shift: string (optional)
    //   - g081_photo: string (optional)
    //   - g081_status: string (optional)
    //   - g081_verified_by: string (optional)
    //   - g081_verified_at: timestamp (optional)
    //   - isDemo: bool (optional)
    //
    // Collection: training
    // Document ID: {trainingId}
    // Fields:
    //   - man_number: string (required)
    //   - course_name: string (required)
    //   - due_date: string (required, ISO 8601)
    //   - shopId: string (required)
    //   - amuId: string (required)
    //   - status: string (required, 'current' | 'expiring' | 'expired')
    //   - isDemo: bool (optional)
    //
    // Collection: difm
    // Document ID: {difmId}
    // Fields:
    // ... (existing fields)
    //   - isDemo: bool (optional)
    //
    // Collection: notifications
    // Document ID: {notificationId}
    // Fields:
    //   - userId: string (optional)
    //   - shopId: string (optional)
    //   - type: string (required, 'red-ball' | 'parts' | 'training' | 'system')
    //   - title: string (required)
    //   - message: string (required)
    //   - isRead: bool (required)
    //   - timestamp: timestamp (required)
    //   - metadata: map (optional)
    //   - isDemo: bool (optional)
    //
    // Collection: presence
    // Document ID: {userId}
    // Fields:
    //   - userId: string (required)
    //   - userName: string (required)
    //   - location: string (required)
    //   - activeAt: timestamp (required)
    //   - shopId: string (required)
    //   - amuId: string (required)
    // ===============================================================

    // Helper Functions
    // ===============================================================

    function isValidNotification(data) {
      return data.keys().hasAll(['type', 'title', 'message', 'isRead', 'timestamp']) &&
             data.type in ['red-ball', 'parts', 'training', 'system'] &&
             data.title is string && data.title.size() > 0 &&
             data.message is string && data.message.size() > 0 &&
             data.isRead is bool &&
             data.timestamp is timestamp &&
             (!('userId' in data) || data.userId is string) &&
             (!('shopId' in data) || data.shopId is string) &&
             (!('isDemo' in data) || data.isDemo is bool);
    }

    function isValidPresence(data) {
      return data.keys().hasAll(['userId', 'userName', 'location', 'activeAt', 'shopId', 'amuId']) &&
             data.userId is string &&
             data.userName is string &&
             data.location is string &&
             data.activeAt is timestamp &&
             data.shopId is string &&
             data.amuId is string &&
             (!('isDemo' in data) || data.isDemo is bool);
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isNCOIC() {
      return isAuthenticated() && getUserData().role == 'ncoic' && getUserData().status == 'active';
    }

    function isTechnician() {
      return isAuthenticated() && getUserData().role == 'technician' && getUserData().status == 'active';
    }

    function isLeadership() {
      return isAuthenticated() && getUserData().role == 'leadership' && getUserData().status == 'active';
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.email == "spkoehl@gmail.com" || request.auth.token.email == "admin@us.af.mil");
    }

    function isSameShop(amuId, shopId) {
      return isAuthenticated() && getUserData().amuId == amuId && getUserData().shopId == shopId && getUserData().status == 'active';
    }

    function isDemo(data) {
      return data.isDemo == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'man_number', 'shopId', 'amuId', 'role', 'email', 'status']) &&
             data.uid is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.man_number is string &&
             data.shopId is string &&
             data.amuId is string &&
             data.role in ['leadership', 'ncoic', 'technician', 'pending'] &&
             data.status in ['active', 'pending', 'rejected'] &&
             data.email is string;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['tail_number', 'discrepancy', 'repair', 'shopId', 'amuId', 'technician_name', 'man_number', 'timestamp']) &&
             data.tail_number is string && data.tail_number.size() > 0 &&
             data.discrepancy is string && data.discrepancy.size() > 0 && data.discrepancy.size() < 5000 &&
             data.repair is string && data.repair.size() > 0 && data.repair.size() < 5000 &&
             data.shopId is string &&
             data.amuId is string &&
             data.technician_name is string &&
             data.man_number is string &&
             data.timestamp is timestamp &&
             (!('jcn' in data) || data.jcn is string || data.jcn == null) &&
             (!('personnel' in data) || data.personnel is list) &&
             (!('isRedBall' in data) || data.isRedBall is bool) &&
             (!('shift' in data) || data.shift in ['Days', 'Swings', 'Nights', 'Weekend Duty']) &&
             (!('g081_photo' in data) || data.g081_photo is string || data.g081_photo == null) &&
             (!('g081_status' in data) || data.g081_status in ['pending', 'verified'] || data.g081_status == null) &&
             (!('g081_verified_by' in data) || data.g081_verified_by is string || data.g081_verified_by == null) &&
             (!('g081_verified_at' in data) || data.g081_verified_at is timestamp || data.g081_verified_at == null) &&
             (!('lastEditedBy' in data) || data.lastEditedBy is string) &&
             (!('lastEditedAt' in data) || data.lastEditedAt is timestamp);
    }

    function isValidTraining(data) {
      return data.keys().hasAll(['man_number', 'course_name', 'due_date', 'shopId', 'amuId', 'status']) &&
             data.man_number is string &&
             data.course_name is string &&
             data.due_date is string &&
             data.shopId is string &&
             data.amuId is string &&
             data.status in ['current', 'expiring', 'expired'];
    }

    function isValidDIFM(data) {
      return data.keys().hasAll(['tail_number', 'discrepancy', 'status', 'shopId', 'amuId', 'technician_name', 'timestamp']) &&
             data.tail_number is string && data.tail_number.size() > 0 &&
             data.discrepancy is string && data.discrepancy.size() > 0 && data.discrepancy.size() < 5000 &&
             data.status in ['due-in', 'awaiting-parts', 'in-repair', 'complete'] &&
             data.shopId is string &&
             data.amuId is string &&
             data.technician_name is string &&
             data.timestamp is timestamp &&
             (!('pipeline_status' in data) || data.pipeline_status in ['ordered', 'en-route', 'received']) &&
             (!('doc_number' in data) || data.doc_number is string) &&
             (!('nsn' in data) || data.nsn is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isDemo(resource.data) || (isAuthenticated() && (request.auth.uid == uid || resource.data.man_number == getUserData().man_number || isSameShop(resource.data.amuId, resource.data.shopId) || isNCOIC() || isLeadership() || isAdmin()));
      allow create: if isDemo(request.resource.data) || (isAuthenticated() && (
        isAdmin() || 
        (isValidUser(request.resource.data) && request.auth.uid == uid && request.resource.data.role == 'pending' && request.resource.data.status == 'pending')
      ));
      allow update: if isDemo(resource.data) || (isAuthenticated() && (
        (request.auth.uid == uid && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status) ||
        (isNCOIC() && isValidUser(request.resource.data)) ||
        (isLeadership() && isValidUser(request.resource.data)) ||
        isAdmin()
      ));
    }

    match /logs/{logId} {
      allow read: if isDemo(resource.data) || (isAuthenticated() && (isSameShop(resource.data.amuId, resource.data.shopId) || isLeadership() || isAdmin()));
      allow create: if isDemo(request.resource.data) || (isAuthenticated() && isValidLog(request.resource.data) && (isAdmin() || isSameShop(request.resource.data.amuId, request.resource.data.shopId)));
      allow update: if isDemo(resource.data) || (isAuthenticated() && isValidLog(request.resource.data) && (isSameShop(resource.data.amuId, resource.data.shopId) || isLeadership() || isAdmin()));
      allow delete: if isDemo(resource.data) || (isAuthenticated() && ((isSameShop(resource.data.amuId, resource.data.shopId) && isNCOIC()) || isLeadership() || isAdmin()));
    }

    match /training/{trainingId} {
      allow read: if isDemo(resource.data) || (isAuthenticated() && (resource.data.man_number == getUserData().man_number || isSameShop(resource.data.amuId, resource.data.shopId) || isLeadership() || isAdmin()));
      allow write: if isDemo(request.resource.data) || (isAuthenticated() && (isAdmin() || isLeadership() || (isNCOIC() && isSameShop(request.resource.data.amuId, request.resource.data.shopId))) && isValidTraining(request.resource.data));
    }

    match /difm/{difmId} {
      allow read: if isDemo(resource.data) || (isAuthenticated() && (isSameShop(resource.data.amuId, resource.data.shopId) || isLeadership() || isAdmin()));
      allow create: if isDemo(request.resource.data) || (isAuthenticated() && isValidDIFM(request.resource.data) && (isAdmin() || isSameShop(request.resource.data.amuId, request.resource.data.shopId)));
      allow update: if isDemo(resource.data) || (isAuthenticated() && isValidDIFM(request.resource.data) && (isSameShop(resource.data.amuId, resource.data.shopId) || isLeadership() || isAdmin()));
      allow delete: if isDemo(resource.data) || (isAuthenticated() && ((isSameShop(resource.data.amuId, resource.data.shopId) && isNCOIC()) || isLeadership() || isAdmin()));
    }

    match /notifications/{notificationId} {
      allow read: if isDemo(resource.data) || (isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.shopId == getUserData().shopId ||
        isLeadership() || isAdmin()
      ));
      allow create: if (isAuthenticated() && isValidNotification(request.resource.data)) || isDemo(request.resource.data);
      allow update: if (isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])) ||
        isAdmin() || isLeadership()
      )) || isDemo(resource.data);
    }

    match /presence/{userId} {
      allow read: if isDemo(resource.data) || (isAuthenticated() && (getUserData().amuId == resource.data.amuId && getUserData().shopId == resource.data.shopId || isLeadership() || isAdmin()));
      allow write: if isDemo(request.resource.data) || (isAuthenticated() && request.auth.uid == userId && isValidPresence(request.resource.data));
    }
  }
}
