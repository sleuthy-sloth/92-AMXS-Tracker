# ─── AI Provider Keys (Local Development Only) ────────────────────
# For local development, set these to use AI features. DO NOT commit
# this file with real keys — keep them in .env.local (gitignored).
#
# PRODUCTION: API keys must be set server-side via Firebase Cloud
# Functions (functions/src/index.ts). Deploy with:
#   firebase deploy --only functions
#
# These use VITE_ prefix so Vite exposes them to client code via
# import.meta.env. In production builds (without .env.local set),
# they will be empty and the client falls back to the Cloud Functions
# proxy.

# VITE_GENAI_MIL_API_KEY: Required for GenAI.mil AI calls.
# Keys lock every 8 hours — visit the unlock URL in the console warning to re-enable.
VITE_GENAI_MIL_API_KEY=""

# VITE_OPENROUTER_API_KEY: Required for fallback AI channel when GenAI.mil is unavailable or locked.
VITE_OPENROUTER_API_KEY=""

# ─── Super Admin ────────────────────────────────────────────────────
# SUPER_ADMIN_EMAIL: Email address of the designated super-administrator.
# This email is granted elevated privileges in Firestore rules and the
# client-side Setup flow. Must match the email used for Google Auth login.
SUPER_ADMIN_EMAIL=""

# ─── Deployment ─────────────────────────────────────────────────────
# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://sleuthy-sloth.github.io/92-AMXS-Tracker/"
