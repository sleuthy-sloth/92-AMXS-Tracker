# ─── AI Provider Keys ───────────────────────────────────────────────
# These keys are injected at build time via vite.config.ts `define` and
# MUST be set as GitHub repository secrets for production deployments.
# NEVER commit real keys to the repository — use .env.local for dev.
#
# The client calls AI providers directly (no Cloud Functions proxy).
# To run locally, copy this file to .env.local and fill in your keys.

# GENAI_MIL_API_KEY: Required for AI API calls (primary provider via GenAI.mil).
# Keys lock every 8 hours — visit the unlock URL in the console warning to re-enable.
GENAI_MIL_API_KEY=""

# OPENROUTER_API_KEY: Required for fallback AI channel when GenAI.mil is unavailable or locked.
OPENROUTER_API_KEY=""

# ─── Super Admin ────────────────────────────────────────────────────
# SUPER_ADMIN_EMAIL: Email address of the designated super-administrator.
# This email is granted elevated privileges in Firestore rules and the
# client-side Setup flow. Must match the email used for Google Auth login.
SUPER_ADMIN_EMAIL=""

# ─── Deployment ─────────────────────────────────────────────────────
# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://sleuthy-sloth.github.io/92-AMXS-Tracker/"
