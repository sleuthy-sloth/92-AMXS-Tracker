{
  "entities": {
    "User": {
      "title": "User",
      "description": "Personnel profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name (Surname, Initial)" },
        "man_number": { "type": "string", "description": "Maintenance number" },
        "shopId": { "type": "string", "description": "Assigned shop identifier" },
        "role": { "type": "string", "enum": ["ncoic", "technician"], "description": "User role" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" }
      },
      "required": ["uid", "name", "man_number", "shopId", "role", "email"]
    },
    "Log": {
      "title": "Maintenance Log",
      "description": "Aircraft maintenance log entry",
      "type": "object",
      "properties": {
        "tail_number": { "type": "string" },
        "discrepancy": { "type": "string" },
        "repair": { "type": "string" },
        "doc_number": { "type": "string", "description": "Optional document number" },
        "shopId": { "type": "string", "description": "Shop that performed the maintenance" },
        "technician_name": { "type": "string" },
        "man_number": { "type": "string", "description": "Technician man number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "isRedBall": { "type": "boolean", "description": "Urgent maintenance flag" },
        "g081_photo": { "type": "string", "description": "Base64 or URL of G081 screen/work proof" },
        "g081_status": { "type": "string", "enum": ["pending", "verified"], "description": "G081 verification status" },
        "g081_verified_by": { "type": "string", "description": "Name of person who verified in G081" },
        "g081_verified_at": { "type": "string", "format": "date-time" }
      },
      "required": ["tail_number", "discrepancy", "repair", "shopId", "technician_name", "man_number", "timestamp"]
    },
    "Training": {
      "title": "Training Record",
      "description": "Personnel training task record",
      "type": "object",
      "properties": {
        "man_number": { "type": "string" },
        "course_name": { "type": "string" },
        "due_date": { "type": "string", "format": "date" },
        "shopId": { "type": "string" },
        "status": { "type": "string", "enum": ["current", "expiring", "expired"] }
      },
      "required": ["man_number", "course_name", "due_date", "shopId", "status"]
    },
    "DIFM": {
      "title": "DIFM Log",
      "description": "Due-In From Maintenance log entry",
      "type": "object",
      "properties": {
        "tail_number": { "type": "string" },
        "discrepancy": { "type": "string" },
        "status": { "type": "string", "enum": ["due-in", "awaiting-parts", "in-repair", "complete"] },
        "shopId": { "type": "string" },
        "technician_name": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["tail_number", "discrepancy", "status", "shopId", "technician_name", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts and user notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Target user UID (optional for broadcast)" },
        "shopId": { "type": "string", "description": "Target shop (optional)" },
        "type": { "type": "string", "enum": ["red-ball", "parts", "training", "system"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object", "description": "Link to related record (e.g., logId)" }
      },
      "required": ["type", "title", "message", "isRead", "timestamp"]
    },
    "Presence": {
      "title": "User Presence",
      "description": "Real-time user status and location within the app",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "location": { "type": "string", "description": "The current page or context (e.g., 'maintenance', 'difm')" },
        "activeAt": { "type": "string", "format": "date-time" },
        "shopId": { "type": "string" }
      },
      "required": ["userId", "userName", "location", "activeAt", "shopId"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "Maintenance logs"
    },
    "/training/{trainingId}": {
      "schema": "Training",
      "description": "Training records"
    },
    "/difm/{difmId}": {
      "schema": "DIFM",
      "description": "DIFM logs"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/presence/{userId}": {
      "schema": "Presence",
      "description": "Real-time user presence"
    }
  }
}
